generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════ Unidad 1: Identidad y Autenticación ══════════════

model Usuario {
  id               String   @id @default(uuid())
  googleSub        String   @unique
  correo           String
  nombre           String
  fotoUrl          String?
  fechaCreacion    DateTime @default(now())
  fechaUltimoLogin DateTime @default(now())

  sesiones            Sesion[]
  membresias          Membresia[]
  gastos              Gasto[]
  invitacionesCreadas Invitacion[] @relation("InvitacionCreador")
}

enum EstadoSesion {
  Activa
  Expirada
  Invalidada
}

model Sesion {
  token                String       @id // hash del token (BR: nunca se guarda el token en claro)
  usuarioId            String
  usuario              Usuario      @relation(fields: [usuarioId], references: [id])
  fechaCreacion        DateTime     @default(now())
  fechaExpiracion      DateTime
  fechaUltimaActividad DateTime     @default(now())
  fechaInvalidacion    DateTime?
  estado               EstadoSesion @default(Activa)

  @@index([usuarioId])
}

// ══════════════ Unidad 2: Grupos Familiares ══════════════

model GrupoFamiliar {
  id            String   @id @default(uuid())
  nombre        String
  fechaCreacion DateTime @default(now())

  membresias           Membresia[]
  invitaciones         Invitacion[]
  gastos               Gasto[]
  presupuestos         Presupuesto[]
  productosAlacena     ProductoAlacena[]
  itemsCompra          ItemCompra[]
  recetas              Receta[]
  planificaciones      PlanificacionDia[]
  productosSegmentados ProductoSegmentado[]
}

enum RolMembresia {
  Administrador
  Miembro
}

model Membresia {
  id              String        @id @default(uuid())
  grupoFamiliarId String
  grupo           GrupoFamiliar @relation(fields: [grupoFamiliarId], references: [id])
  usuarioId       String
  usuario         Usuario       @relation(fields: [usuarioId], references: [id])
  rol             RolMembresia
  fechaIngreso    DateTime      @default(now())

  @@unique([grupoFamiliarId, usuarioId])
  @@index([usuarioId])
}

enum EstadoInvitacion {
  Pendiente
  Aceptada
  Expirada
  Revocada
}

model Invitacion {
  id                  String           @id @default(uuid())
  grupoFamiliarId     String
  grupo               GrupoFamiliar    @relation(fields: [grupoFamiliarId], references: [id])
  tokenInvitacionHash String           @unique
  correoInvitado      String?
  estado              EstadoInvitacion @default(Pendiente)
  fechaCreacion       DateTime         @default(now())
  fechaExpiracion     DateTime
  creadaPorUsuarioId  String
  creadaPor           Usuario          @relation("InvitacionCreador", fields: [creadaPorUsuarioId], references: [id])

  @@index([grupoFamiliarId])
}

// ══════════════ Unidad 3: Núcleo Financiero ══════════════

model Gasto {
  id              String        @id @default(uuid())
  grupoFamiliarId String
  grupo           GrupoFamiliar @relation(fields: [grupoFamiliarId], references: [id])
  usuarioId       String
  usuario         Usuario       @relation(fields: [usuarioId], references: [id])
  descripcion     String
  monto           Decimal       @db.Decimal(12, 2)
  categoria       String
  fecha           DateTime      @default(now())

  @@index([grupoFamiliarId])
  @@index([grupoFamiliarId, categoria])
}

model Presupuesto {
  id              String        @id @default(uuid())
  grupoFamiliarId String
  grupo           GrupoFamiliar @relation(fields: [grupoFamiliarId], references: [id])
  categoria       String
  montoAsignado   Decimal       @db.Decimal(12, 2)

  @@unique([grupoFamiliarId, categoria])
}

// ══════════════ Unidad 4: Hogar ══════════════

model ProductoAlacena {
  id              String        @id @default(uuid())
  grupoFamiliarId String
  grupo           GrupoFamiliar @relation(fields: [grupoFamiliarId], references: [id])
  icono           String        @default("📦")
  nombre          String
  cantidadTexto   String
  porAgotarse     Boolean       @default(false)

  @@index([grupoFamiliarId])
}

model ItemCompra {
  id              String        @id @default(uuid())
  grupoFamiliarId String
  grupo           GrupoFamiliar @relation(fields: [grupoFamiliarId], references: [id])
  nombre          String
  precioEstimado  Decimal       @default(0) @db.Decimal(12, 2)
  comprado        Boolean       @default(false)

  @@index([grupoFamiliarId])
}

model Receta {
  id              String        @id @default(uuid())
  grupoFamiliarId String
  grupo           GrupoFamiliar @relation(fields: [grupoFamiliarId], references: [id])
  nombre          String
  tipos           String[]
  tiempoMin       Int
  porciones       Int
  ingredientes    Json
  pasos           String[]

  planificaciones PlanificacionDia[]

  @@index([grupoFamiliarId])
}

model PlanificacionDia {
  id              String        @id @default(uuid())
  grupoFamiliarId String
  grupo           GrupoFamiliar @relation(fields: [grupoFamiliarId], references: [id])
  fecha           DateTime
  tipoComida      String
  recetaId        String
  receta          Receta        @relation(fields: [recetaId], references: [id])

  @@index([grupoFamiliarId])
  @@index([grupoFamiliarId, fecha])
}

// ══════════════ Unidad 5: Insights ══════════════

model ProductoSegmentado {
  id              String        @id @default(uuid())
  grupoFamiliarId String
  grupo           GrupoFamiliar @relation(fields: [grupoFamiliarId], references: [id])
  nombre          String
  categoria       String
  frecuencia      String
  precioUnitario  Decimal       @db.Decimal(12, 2)
  cantidad        Int
  segmento        String // cat1 | cat2 | saving
  justificacion   String

  @@index([grupoFamiliarId])
}
