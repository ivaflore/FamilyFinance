generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ══════════════ Unidad 1: Identidad y Autenticación ══════════════

model Usuario {
  id               String   @id @default(uuid())
  googleSub        String   @unique
  correo           String
  nombre           String
  fotoUrl          String?
  fechaCreacion    DateTime @default(now())
  fechaUltimoLogin DateTime @default(now())

  sesiones            Sesion[]
  membresias          Membresia[]
  gastos              Gasto[]
  invitacionesCreadas Invitacion[] @relation("InvitacionCreador")
  ingresos            Ingreso[]
  movimientosMesada   MovimientoMesada[]
  metasAhorro         MetaAhorro[]
  tareasAsignadas     Tarea[]            @relation("TareaAsignado")
  pushSubscriptions   PushSubscription[]
}

enum EstadoSesion {
  Activa
  Expirada
  Invalidada
}

model Sesion {
  token                String       @id // hash del token (BR: nunca se guarda el token en claro)
  usuarioId            String
  usuario              Usuario      @relation(fields: [usuarioId], references: [id])
  fechaCreacion        DateTime     @default(now())
  fechaExpiracion      DateTime
  fechaUltimaActividad DateTime     @default(now())
  fechaInvalidacion    DateTime?
  estado               EstadoSesion @default(Activa)

  @@index([usuarioId])
}

// ══════════════ Unidad 2: Grupos Familiares ══════════════

model GrupoFamiliar {
  id            String   @id @default(uuid())
  nombre        String
  fechaCreacion DateTime @default(now())

  membresias           Membresia[]
  invitaciones         Invitacion[]
  gastos               Gasto[]
  presupuestos         Presupuesto[]
  productosAlacena     ProductoAlacena[]
  itemsCompra          ItemCompra[]
  recetas              Receta[]
  planificaciones      PlanificacionDia[]
  productosSegmentados ProductoSegmentado[]
  gastosRecurrentes    GastoRecurrente[]
  ingresos             Ingreso[]
  movimientosMesada    MovimientoMesada[]
  metasAhorro          MetaAhorro[]
  tareas               Tarea[]
}

enum RolMembresia {
  Administrador
  Miembro
}

model Membresia {
  id              String        @id @default(uuid())
  grupoFamiliarId String
  grupo           GrupoFamiliar @relation(fields: [grupoFamiliarId], references: [id])
  usuarioId       String
  usuario         Usuario       @relation(fields: [usuarioId], references: [id])
  rol             RolMembresia
  fechaIngreso    DateTime      @default(now())

  @@unique([grupoFamiliarId, usuarioId])
  @@index([usuarioId])
}

enum EstadoInvitacion {
  Pendiente
  Aceptada
  Expirada
  Revocada
}

model Invitacion {
  id                  String           @id @default(uuid())
  grupoFamiliarId     String
  grupo               GrupoFamiliar    @relation(fields: [grupoFamiliarId], references: [id])
  tokenInvitacionHash String           @unique
  correoInvitado      String?
  estado              EstadoInvitacion @default(Pendiente)
  fechaCreacion       DateTime         @default(now())
  fechaExpiracion     DateTime
  creadaPorUsuarioId  String
  creadaPor           Usuario          @relation("InvitacionCreador", fields: [creadaPorUsuarioId], references: [id])

  @@index([grupoFamiliarId])
}

// ══════════════ Unidad 3: Núcleo Financiero ══════════════

model Gasto {
  id                String           @id @default(uuid())
  grupoFamiliarId   String
  grupo             GrupoFamiliar    @relation(fields: [grupoFamiliarId], references: [id])
  usuarioId         String
  usuario           Usuario          @relation(fields: [usuarioId], references: [id])
  descripcion       String
  monto             Decimal          @db.Decimal(12, 2)
  categoria         String
  fecha             DateTime         @default(now())
  gastoRecurrenteId String?
  gastoRecurrente   GastoRecurrente? @relation(fields: [gastoRecurrenteId], references: [id])

  @@index([grupoFamiliarId])
  @@index([grupoFamiliarId, categoria])
}

model Presupuesto {
  id              String        @id @default(uuid())
  grupoFamiliarId String
  grupo           GrupoFamiliar @relation(fields: [grupoFamiliarId], references: [id])
  categoria       String
  montoAsignado   Decimal       @db.Decimal(12, 2)

  @@unique([grupoFamiliarId, categoria])
}

// Plantilla de un gasto fijo del mes (arriendo, luz, colegio...). Cada mes se
// genera automáticamente un Gasto real a partir de esta plantilla (idempotente
// — nunca duplica el mismo mes), enlazado vía Gasto.gastoRecurrenteId.
model GastoRecurrente {
  id              String        @id @default(uuid())
  grupoFamiliarId String
  grupo           GrupoFamiliar @relation(fields: [grupoFamiliarId], references: [id])
  descripcion     String
  monto           Decimal       @db.Decimal(12, 2)
  categoria       String
  diaDelMes       Int
  activo          Boolean       @default(true)
  fechaCreacion   DateTime      @default(now())

  gastos          Gasto[]

  @@index([grupoFamiliarId])
}

model Ingreso {
  id              String        @id @default(uuid())
  grupoFamiliarId String
  grupo           GrupoFamiliar @relation(fields: [grupoFamiliarId], references: [id])
  usuarioId       String
  usuario         Usuario       @relation(fields: [usuarioId], references: [id])
  descripcion     String
  monto           Decimal       @db.Decimal(12, 2)
  fecha           DateTime      @default(now())

  @@index([grupoFamiliarId])
}

// ══════════════ Unidad 4: Hogar ══════════════

model ProductoAlacena {
  id              String        @id @default(uuid())
  grupoFamiliarId String
  grupo           GrupoFamiliar @relation(fields: [grupoFamiliarId], references: [id])
  icono           String        @default("📦")
  nombre          String
  unidad          String        @default("unidades")
  categoria       String        @default("Otros")
  cantidadIdeal   Decimal       @default(1) @db.Decimal(10, 2)
  cantidadActual  Decimal       @default(1) @db.Decimal(10, 2)
  precioEstimado  Decimal       @default(0) @db.Decimal(12, 2)

  @@index([grupoFamiliarId])
}

model ItemCompra {
  id              String        @id @default(uuid())
  grupoFamiliarId String
  grupo           GrupoFamiliar @relation(fields: [grupoFamiliarId], references: [id])
  nombre          String
  precioEstimado  Decimal       @default(0) @db.Decimal(12, 2)
  comprado        Boolean       @default(false)

  @@index([grupoFamiliarId])
}

// Catálogo de recetas sugeridas, compartido entre todos los grupos (solo
// lectura). No lleva grupoFamiliarId porque no es dato de un tenant — es
// contenido de referencia que cada grupo puede copiar a su propio recetario.
model RecetaPlantilla {
  id           String   @id @default(uuid())
  nombre       String
  tipos        String[]
  tiempoMin    Int
  porciones    Int
  ingredientes Json
  pasos        String[]
}

model Receta {
  id              String        @id @default(uuid())
  grupoFamiliarId String
  grupo           GrupoFamiliar @relation(fields: [grupoFamiliarId], references: [id])
  nombre          String
  tipos           String[]
  tiempoMin       Int
  porciones       Int
  ingredientes    Json
  pasos           String[]

  planificaciones PlanificacionDia[]

  @@index([grupoFamiliarId])
}

model PlanificacionDia {
  id              String        @id @default(uuid())
  grupoFamiliarId String
  grupo           GrupoFamiliar @relation(fields: [grupoFamiliarId], references: [id])
  fecha           DateTime
  tipoComida      String
  recetaId        String
  receta          Receta        @relation(fields: [recetaId], references: [id])

  @@index([grupoFamiliarId])
  @@index([grupoFamiliarId, fecha])
}

// ══════════════ Unidad 5: Insights ══════════════

model ProductoSegmentado {
  id              String        @id @default(uuid())
  grupoFamiliarId String
  grupo           GrupoFamiliar @relation(fields: [grupoFamiliarId], references: [id])
  nombre          String
  categoria       String
  frecuencia      String
  precioUnitario  Decimal       @db.Decimal(12, 2)
  cantidad        Int
  segmento        String // cat1 | cat2 | saving
  justificacion   String

  @@index([grupoFamiliarId])
}

// ══════════════ Unidad 6: Mesada y Tareas del Hogar ══════════════
// Pensada para los hijos del grupo (aunque cualquier miembro puede usarla):
// un registro personal de plata (mesada, gastos propios, ahorro) y tareas
// del hogar que un administrador puede asignar y ligar a una recompensa.

// Movimiento de la cuenta personal de un usuario dentro del grupo. El saldo
// SIEMPRE se deriva de la suma de sus movimientos (mismo criterio que
// BR-15 para el presupuesto) — nunca un contador aparte. monto positivo =
// ingreso (mesada, recompensa), negativo = retiro/gasto propio.
model MovimientoMesada {
  id              String        @id @default(uuid())
  grupoFamiliarId String
  grupo           GrupoFamiliar @relation(fields: [grupoFamiliarId], references: [id])
  usuarioId       String
  usuario         Usuario       @relation(fields: [usuarioId], references: [id])
  descripcion     String
  monto           Decimal       @db.Decimal(12, 2)
  fecha           DateTime      @default(now())

  @@index([grupoFamiliarId, usuarioId])
}

// Meta de ahorro personal (ej. "bicicleta nueva"). El progreso se deriva
// comparando el saldo actual del usuario (suma de MovimientoMesada) contra
// montoObjetivo — no se reserva plata aparte.
model MetaAhorro {
  id              String        @id @default(uuid())
  grupoFamiliarId String
  grupo           GrupoFamiliar @relation(fields: [grupoFamiliarId], references: [id])
  usuarioId       String
  usuario         Usuario       @relation(fields: [usuarioId], references: [id])
  nombre          String
  montoObjetivo   Decimal       @db.Decimal(12, 2)
  activa          Boolean       @default(true)
  fechaCreacion   DateTime      @default(now())

  @@index([grupoFamiliarId, usuarioId])
}

// Tarea del hogar, opcionalmente asignada a un miembro y con una recompensa
// en dinero. Al marcarla completada con recompensa > 0, se acredita
// automáticamente como un MovimientoMesada del asignado.
model Tarea {
  id                 String        @id @default(uuid())
  grupoFamiliarId    String
  grupo              GrupoFamiliar @relation(fields: [grupoFamiliarId], references: [id])
  titulo             String
  asignadoAUsuarioId String?
  asignadoA          Usuario?      @relation("TareaAsignado", fields: [asignadoAUsuarioId], references: [id])
  recompensa         Decimal       @default(0) @db.Decimal(12, 2)
  completada         Boolean       @default(false)
  fechaCreacion      DateTime      @default(now())

  @@index([grupoFamiliarId])
}

// ══════════════ Notificaciones Push ══════════════

model PushSubscription {
  id            String   @id @default(uuid())
  usuarioId     String
  usuario       Usuario  @relation(fields: [usuarioId], references: [id])
  endpoint      String   @unique
  p256dh        String
  auth          String
  fechaCreacion DateTime @default(now())

  @@index([usuarioId])
}
