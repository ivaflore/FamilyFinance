DATABASE_URL=postgresql://familyfinance:familyfinance@localhost:5432/familyfinance
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
SESSION_COOKIE_SECURE=false
PORT=3000

# Opcional: habilita el asistente con IA real y el escaneo de boletas.
# Sin esta clave, ambas funciones siguen operando en modo degradado (el
# asistente usa reglas locales; el escaneo de boletas queda deshabilitado).
# Clave gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Opcional: habilita las notificaciones push (Web Push / VAPID). Se
# autogeneran, no dependen de ninguna cuenta externa. Sin estas claves, el
# botón "Activar notificaciones" queda oculto pero el resto de la app
# funciona igual. Generar un par nuevo con:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
